# SERVER
PORT=8001
HOST=0.0.0.0

# DATABASE (Azure Cosmos DB or Local MongoDB)
# Mapping: In production, map COSMOS_CONNECTION_STRING from Vault here
MONGODB_URI=mongodb://localhost:27017
DB_NAME=organistation_auth

# SECURITY (MANDATORY - NO FALLBACKS)
# Must match Gateway JWT_SECRET exactly
JWT_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# INTERNAL COMMUNICATION (MANDATORY)
# Shared secret used for secure service-to-service calls
INTERNAL_SERVICE_SECRET=

# DOWNSTREAM SERVICES
HR_SERVICE_URL=http://hr:8002
PROJECT_SERVICE_URL=http://projects:8003
FINANCE_SERVICE_URL=http://finance:8004
